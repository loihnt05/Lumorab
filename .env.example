# Copy to .env. Spring Boot and Docker Compose both read it from this directory.
# Local development only. Supply credentials via environment/secret store elsewhere.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homestay_booking
DB_USER=lumora
DB_PASSWORD=lumora_local_only
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave empty until a Clerk application exists. Protected endpoints then reject all tokens.
# Exact Clerk Frontend API / issuer URL, e.g. https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
# Exact origins permitted in session token azp (comma-separated); independent of CORS.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional. Set only if your Clerk session tokens include this aud claim.
CLERK_AUDIENCE=
