# Copy to .env. Spring Boot and Docker Compose both read it from this directory.
# Local development only. Supply credentials via environment/secret store elsewhere.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=homestay_booking
DB_USER=lumora
DB_PASSWORD=lumora_local_only
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave empty until a Clerk application exists. Protected endpoints then reject all tokens.
# Exact Clerk Frontend API / issuer URL, e.g. https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
# Exact origins permitted in session token azp (comma-separated); independent of CORS.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional. Set only if your Clerk session tokens include this aud claim.
CLERK_AUDIENCE=

# Daily room access codes (startup catch-up and midnight in Vietnam)
ROOM_CODES_ENABLED=true
ROOM_CODES_ZONE=Asia/Ho_Chi_Minh
ROOM_CODES_CRON=0 0 0 * * *
ROOM_CODES_LENGTH=6

# Booking hold and expiration worker
BOOKING_HOLD_DURATION=15m
BOOKING_ZONE=Asia/Ho_Chi_Minh
BOOKING_MAX_STAY_NIGHTS=365
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_INTERVAL=30s
BOOKING_EXPIRY_BATCH_SIZE=100

# Cancellation Policy v1
CANCELLATION_FREE_HOURS=48
CANCELLATION_PARTIAL_HOURS=24

# Payment providers and webhook verification
PAYMENT_MOCK_ENABLED=true
PAYMENT_DEFAULT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=lumora-stage7-webhook-secret-key

# Public & webhook rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
